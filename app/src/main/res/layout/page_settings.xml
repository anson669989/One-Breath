<?xml version="1.0" encoding="utf-8"?>
<!-- 設定頁：全域時間設定、語言、關於與隱私、總開關（總開關必須是最後一項） -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="28dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/TextPageTitle"
            android:text="@string/title_settings" />

        <TextView
            style="@style/TextHint"
            android:text="@string/settings_tagline"
            android:textSize="14sp" />

        <!-- 開啟前 -->
        <TextView
            style="@style/TextCaption"
            android:text="@string/feature_pause" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/delay_title" />

                <TextView
                    android:id="@+id/labelDelay"
                    style="@style/TextValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />

            <TextView
                style="@style/TextHint"
                android:text="@string/settings_delay_hint" />

            <View style="@style/Hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/settings_grace_title" />

                <TextView
                    android:id="@+id/labelGrace"
                    style="@style/TextValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekGrace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />

            <TextView
                style="@style/TextHint"
                android:text="@string/settings_grace_hint" />
        </LinearLayout>

        <!-- 使用中提醒 -->
        <TextView
            style="@style/TextCaption"
            android:text="@string/feature_remind" />

        <LinearLayout style="@style/CardBox">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/remind_interval_title" />

                <TextView
                    android:id="@+id/labelRemind"
                    style="@style/TextValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekRemind"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />

            <TextView
                style="@style/TextHint"
                android:text="@string/settings_remind_hint" />

            <View style="@style/Hairline" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextCardTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/remind_delay_title" />

                <TextView
                    android:id="@+id/labelRemindDelay"
                    style="@style/TextValue" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seekRemindDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp" />

            <TextView
                style="@style/TextHint"
                android:text="@string/settings_remind_delay_hint" />
        </LinearLayout>

        <!-- 語言 -->
        <TextView
            style="@style/TextCaption"
            android:text="@string/language_caption" />

        <LinearLayout style="@style/CardBox">

            <!-- 和群組編輯頁「設定｜App」同一種分段切換（bg_segment / bg_segment_on） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_segment"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/langSystem"
                    style="@style/SegmentItem"
                    android:text="@string/lang_system" />

                <TextView
                    android:id="@+id/langZh"
                    style="@style/SegmentItem"
                    android:text="@string/lang_zh" />

                <TextView
                    android:id="@+id/langEn"
                    style="@style/SegmentItem"
                    android:text="@string/lang_en" />
            </LinearLayout>

            <TextView
                style="@style/TextHint"
                android:layout_marginTop="8dp"
                android:text="@string/lang_hint" />
        </LinearLayout>

        <!-- 關於／隱私 -->
        <TextView
            style="@style/TextCaption"
            android:text="@string/about_title" />

        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/TextBody"
                android:text="@string/about_body" />

            <TextView
                style="@style/TextHint"
                android:layout_marginTop="10dp"
                android:text="@string/about_access" />

            <View style="@style/Hairline" />

            <TextView
                style="@style/TextCardTitle"
                android:text="@string/samsung_title" />

            <TextView
                style="@style/TextHint"
                android:text="@string/samsung_body" />

            <View style="@style/Hairline" />

            <TextView
                android:id="@+id/versionText"
                style="@style/TextHint"
                android:layout_marginTop="0dp"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <!-- 總開關 -->
        <TextView
            style="@style/TextCaption"
            android:text="@string/master_caption" />

        <LinearLayout
            android:id="@+id/masterRow"
            style="@style/CardBox"
            android:background="@drawable/bg_card_click"
            android:gravity="center_vertical"
            android:minHeight="72dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextCardTitle"
                    android:text="@string/master_title" />

                <TextView
                    style="@style/TextHint"
                    android:text="@string/master_hint" />
            </LinearLayout>

            <Switch
                android:id="@+id/masterSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:minHeight="48dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
