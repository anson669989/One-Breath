<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <!-- focusableInTouchMode：避免一進來搜尋框就自動跳出鍵盤 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingTop="28dp"
            android:paddingRight="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="喘口氣"
                android:textColor="#E8EEF8"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="打開分心 App 前先深呼吸幾秒，想開還是開得了。"
                android:textColor="#8C9AB5"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="14dp"
                android:textSize="15sp" />

            <Button
                android:id="@+id/accessBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#3D7BFF"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/samsungHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="開關是灰色按不了？先按下面按鈕 → 右上角 ⋮ →「允許受限制的設定」，再回來按 ①。"
                android:textColor="#8C9AB5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/appInfoBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#1E3A70"
                android:text="開啟 App 資訊頁"
                android:textColor="#E8EEF8" />

            <Switch
                android:id="@+id/enableSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="啟用提醒"
                android:textColor="#E8EEF8"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/delayLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#E8EEF8"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/delaySeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="30" />

            <TextView
                android:id="@+id/graceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="#E8EEF8"
                android:textSize="15sp" />

            <SeekBar
                android:id="@+id/graceSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="29" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="② 勾選要提醒的 App"
                android:textColor="#E8EEF8"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/search_box"
                android:drawableLeft="@android:drawable/ic_menu_search"
                android:drawablePadding="6dp"
                android:hint="搜尋 App"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingLeft="10dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="#E8EEF8"
                android:textColorHint="#5D6B88"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="20dp"
                android:text="載入 App 中…"
                android:textColor="#8C9AB5"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
