<?xml version="1.0" encoding="utf-8"?>
<!-- 群組頁：每個群組一張卡片 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="28dp"
        android:paddingRight="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TextPageTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/title_groups" />

            <Button
                android:id="@+id/addGroupBtn"
                style="@style/PillButton"
                android:layout_marginLeft="12dp"
                android:text="@string/groups_add" />
        </LinearLayout>

        <TextView
            style="@style/TextHint"
            android:text="@string/groups_tagline"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/groupList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/groupsEmpty"
            style="@style/CardBox"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                style="@style/TextCardTitle"
                android:text="@string/groups_empty_title" />

            <TextView
                style="@style/TextHint"
                android:layout_marginTop="8dp"
                android:text="@string/groups_empty_body1" />

            <TextView
                style="@style/TextHint"
                android:layout_marginTop="8dp"
                android:text="@string/groups_empty_body2" />

            <Button
                android:id="@+id/emptyAddBtn"
                style="@style/PillButton"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/create_first_group" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
